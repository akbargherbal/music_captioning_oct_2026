{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "model": "deepseek/deepseek-flash#high"
    },
    "plan": {
      "model": "deepseek/deepseek-flash#high"
    }
  }
}